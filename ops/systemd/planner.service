[Unit]
Description=Planner workspace
After=planner-mongodb.service
ConditionPathExists=/etc/planner/planner.json
ConditionPathExists=/etc/planner/mongod.conf

[Service]
User=planner
Group=planner
WorkingDirectory=/opt/planner/current
Environment=PLANNER_NATIVE_INSTALLATION=1
ExecStart=/opt/planner/current/runtime/node/bin/node /opt/planner/current/apps/backend/dist/main.js
RuntimeDirectory=planner
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Staging and blobs must share one mount for atomic hard-link publication.
ReadWritePaths=/var/lib/planner /run/planner /run/planner-proxy
InaccessiblePaths=/var/lib/planner/mongodb

[Install]
WantedBy=multi-user.target
