{
  "name": "planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/contracts",
    "apps/backend",
    "apps/frontend",
    "tools/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p tests/tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:health",
    "verify:clean": "npm ci --strict-peer-deps && npm ls --all && npm run verify",
    "test:health": "node --import tsx --test tests/health.test.mjs",
    "dev": "npm run build --workspace @planner/contracts && npm run dev --workspace @planner/frontend",
    "test:shell": "node --import tsx --test tests/shell.test.mjs",
    "test": "node --import tsx --test \"tests/unit/**/*.test.{ts,mjs}\"",
    "test:integration": "node tests/run-integration.ts",
    "test:e2e": "npm run build && npm run test:shell"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
