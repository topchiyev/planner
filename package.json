{
  "name": "planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/contracts",
    "apps/backend",
    "apps/frontend",
    "tools/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p tests/tsconfig.json",
    "verify": "node tests/run-suite.ts verify",
    "verify:clean": "node tests/run-suite.ts verify:clean",
    "test:health": "node tests/run-suite.ts health",
    "dev": "npm run build --workspace @planner/contracts && npm run dev --workspace @planner/frontend",
    "test:shell": "node tests/run-suite.ts shell",
    "test": "node tests/run-suite.ts unit",
    "test:integration": "node tests/run-suite.ts integration",
    "test:e2e": "node tests/run-suite.ts e2e"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
